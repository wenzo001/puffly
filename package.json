{
  "name": "puffly",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Take a break. Skip the smoke.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev --workspace @puffly/web",
    "build": "npm run typecheck && npm run build --workspace @puffly/web",
    "preview": "npm run preview --workspace @puffly/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.11",
    "workbox-build": "7.4.1"
  }
}
